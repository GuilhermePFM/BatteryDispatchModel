# cognito | dev. dev sends "Bearer dev:<sub>:<email>" (the API must run with AUTH_MODE=dev).
VITE_AUTH_MODE=dev
# Cognito user pool issuer. Production is in us-east-1, e.g.
# https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXX (the local stack uses eu-west-2, but has no Cognito)
VITE_COGNITO_AUTHORITY=
# The SPA app client id
VITE_COGNITO_CLIENT_ID=
# Managed login domain, for logout, e.g. https://batteryplan.auth.us-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=
# 1 serves the contract examples from an in-browser fetch shim instead of calling /api
VITE_API_MOCK=
# Where links from the methodology to other repository documents point; empty keeps them as text
VITE_REPO_URL=https://github.com/GuilhermePFM/BatteryCase/blob/main

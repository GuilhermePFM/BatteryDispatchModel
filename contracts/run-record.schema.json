{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batteryplan.invalid/contracts/run-record.schema.json",
  "title": "Run record",
  "description": "A run as stored in DynamoDB and returned by GET /api/runs/{run_id}, in its JSON form. The API writes it queued; the solver moves it to running, updates progress, and finishes it succeeded or failed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "run_id", "user_sub", "params_hash", "status", "request", "created_at", "updated_at"],
  "properties": {
    "version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "user_sub": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "params_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": ["queued", "running", "succeeded", "failed"]
    },
    "request": {
      "$ref": "run-request.schema.json"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "finished_at": {
      "$ref": "#/$defs/timestamp"
    },
    "progress": {
      "$ref": "#/$defs/progress"
    },
    "error": {
      "description": "Why the run failed, written for the user: a bad price file names the row to fix.",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "description": "prices_invalid: the price file was rejected; request_invalid: the request does not fit the prices (e.g. dates outside them); solver_failed: anything else.",
          "enum": ["prices_invalid", "request_invalid", "solver_failed"]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "result": {
      "$ref": "result.schema.json"
    },
    "plan_csv_key": {
      "description": "S3 key of the half-hourly plan CSV (the columns of battery_plan.modelling.plan.COLUMNS, indexed by timestamp).",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "plan_csv_url": {
      "description": "API response only, never stored: a presigned GET of plan_csv_key, valid 1 h, added by GET /api/runs/{run_id} once the run has succeeded.",
      "type": "string",
      "format": "uri"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "running"}}},
      "then": {"required": ["started_at"]}
    },
    {
      "if": {"properties": {"status": {"const": "succeeded"}}},
      "then": {"required": ["started_at", "finished_at", "result", "plan_csv_key"]}
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {"required": ["finished_at", "error"]}
    }
  ],
  "$defs": {
    "timestamp": {
      "description": "UTC, RFC 3339, e.g. 2026-11-18T09:30:00Z.",
      "type": "string",
      "format": "date-time"
    },
    "progress": {
      "description": "The latest battery_plan.reporting.ProgressEvent, field for field (dataclasses.asdict), plus when it was written.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "pass_index",
        "passes_estimated",
        "passes_max",
        "pass_fraction",
        "fraction",
        "cycle_value",
        "elapsed",
        "done",
        "updated_at"
      ],
      "properties": {
        "phase": {
          "description": "inputs, horizon, calibrate, recover or done.",
          "type": "string"
        },
        "pass_index": {
          "description": "Pass of the cycle-value search in flight, from 1; 0 before the first.",
          "type": "integer",
          "minimum": 0
        },
        "passes_estimated": {
          "description": "Projected passes for the whole run; null until two passes give a rate to project from.",
          "type": ["integer", "null"],
          "minimum": 1
        },
        "passes_max": {
          "description": "The search's pass ceiling; null until the search has started.",
          "type": ["integer", "null"],
          "minimum": 1
        },
        "pass_fraction": {
          "description": "Share of the current pass's windows solved.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fraction": {
          "description": "Estimated share of the run done. Never decreases; 1 only once done.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cycle_value": {
          "description": "Cycle value of the pass in flight, GBP per cycle.",
          "type": "number",
          "minimum": 0
        },
        "elapsed": {
          "description": "Seconds since the run started.",
          "type": "number",
          "minimum": 0
        },
        "done": {
          "type": "boolean"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    }
  }
}

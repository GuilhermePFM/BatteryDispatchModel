{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://batteryplan.invalid/contracts/result.schema.json",
  "title": "Run result",
  "description": "What battery_plan.analysis.build_result_payload returns: the headline figures of a run and the series its results page draws. Money in GBP, energy in MWh, power in MW, prices in GBP/MWh, shares as fractions (0.25 = 25%). Scalars are full precision; series are rounded, column by column, with null where a value is undefined. Timestamps are the price data's own clock, without an offset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "horizon",
    "battery",
    "headline",
    "certificate",
    "markets",
    "profit_split",
    "cycles",
    "yardstick",
    "costs",
    "checks",
    "spread_explanation",
    "series"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "periods",
        "days",
        "period_minutes"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/local_timestamp"
        },
        "end": {
          "$ref": "#/$defs/local_timestamp"
        },
        "periods": {
          "type": "integer",
          "minimum": 0
        },
        "days": {
          "type": "integer",
          "minimum": 0
        },
        "period_minutes": {
          "$ref": "#/$defs/number"
        }
      },
      "description": "The span dispatched: first and last half hour."
    },
    "battery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "power_charge_mw",
        "power_discharge_mw",
        "volume_mwh",
        "round_trip_efficiency",
        "breakeven_markup",
        "degradation_per_cycle",
        "cycle_budget"
      ],
      "properties": {
        "power_charge_mw": {
          "$ref": "#/$defs/number"
        },
        "power_discharge_mw": {
          "$ref": "#/$defs/number"
        },
        "volume_mwh": {
          "$ref": "#/$defs/number"
        },
        "round_trip_efficiency": {
          "$ref": "#/$defs/number"
        },
        "breakeven_markup": {
          "$ref": "#/$defs/number"
        },
        "degradation_per_cycle": {
          "$ref": "#/$defs/number"
        },
        "cycle_budget": {
          "$ref": "#/$defs/number"
        }
      },
      "description": "The battery in the model's units: degradation_per_cycle is a fraction, breakeven_markup how far a sale must beat its purchase."
    },
    "headline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profit_gbp",
        "net_revenue_market_1_gbp",
        "net_revenue_market_2_gbp",
        "income_gbp",
        "cost_gbp",
        "energy_bought_mwh",
        "energy_delivered_mwh",
        "mean_buy_price_gbp_per_mwh",
        "mean_sell_price_gbp_per_mwh",
        "cycles_used",
        "cycle_budget",
        "final_storage_mwh",
        "final_usable_volume_mwh",
        "periods",
        "periods_charging",
        "periods_discharging",
        "periods_idle",
        "profit_per_cycle_gbp",
        "degradation_pct"
      ],
      "properties": {
        "profit_gbp": {
          "$ref": "#/$defs/number"
        },
        "net_revenue_market_1_gbp": {
          "$ref": "#/$defs/number"
        },
        "net_revenue_market_2_gbp": {
          "$ref": "#/$defs/number"
        },
        "income_gbp": {
          "$ref": "#/$defs/number"
        },
        "cost_gbp": {
          "$ref": "#/$defs/number"
        },
        "energy_bought_mwh": {
          "$ref": "#/$defs/number"
        },
        "energy_delivered_mwh": {
          "$ref": "#/$defs/number"
        },
        "mean_buy_price_gbp_per_mwh": {
          "$ref": "#/$defs/nullable_number"
        },
        "mean_sell_price_gbp_per_mwh": {
          "$ref": "#/$defs/nullable_number"
        },
        "cycles_used": {
          "$ref": "#/$defs/number"
        },
        "cycle_budget": {
          "$ref": "#/$defs/number"
        },
        "final_storage_mwh": {
          "$ref": "#/$defs/number"
        },
        "final_usable_volume_mwh": {
          "$ref": "#/$defs/number"
        },
        "periods": {
          "type": "integer",
          "minimum": 0
        },
        "periods_charging": {
          "type": "integer",
          "minimum": 0
        },
        "periods_discharging": {
          "type": "integer",
          "minimum": 0
        },
        "periods_idle": {
          "type": "integer",
          "minimum": 0
        },
        "profit_per_cycle_gbp": {
          "$ref": "#/$defs/nullable_number"
        },
        "degradation_pct": {
          "$ref": "#/$defs/number"
        }
      },
      "description": "battery_plan.modelling.plan.summarise, plus idle periods, profit per cycle and degradation in percent of volume. Net revenues per market are net of what was bought there, so one is usually negative."
    },
    "certificate": {
      "description": "The cycle-value search behind the plan; null when the payload was built from a plan alone. The dual bound is an upper bound on profit; plan_gap is how far below it the plan landed.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cycle_value",
            "passes",
            "dual_bound_gbp",
            "dual_gap",
            "plan_gap"
          ],
          "properties": {
            "cycle_value": {
              "$ref": "#/$defs/number"
            },
            "passes": {
              "type": "integer",
              "minimum": 1
            },
            "dual_bound_gbp": {
              "$ref": "#/$defs/nullable_number"
            },
            "dual_gap": {
              "$ref": "#/$defs/nullable_number"
            },
            "plan_gap": {
              "$ref": "#/$defs/nullable_number"
            }
          }
        }
      ]
    },
    "markets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "share_market_2_dearer",
        "mean_spread_gbp_per_mwh",
        "bought_market_1_mwh",
        "bought_market_2_mwh",
        "delivered_market_1_mwh",
        "delivered_market_2_mwh",
        "share_days_worth_trading",
        "selling_periods_per_day",
        "buying_periods_per_day"
      ],
      "properties": {
        "share_market_2_dearer": {
          "$ref": "#/$defs/number"
        },
        "mean_spread_gbp_per_mwh": {
          "$ref": "#/$defs/number"
        },
        "bought_market_1_mwh": {
          "$ref": "#/$defs/number"
        },
        "bought_market_2_mwh": {
          "$ref": "#/$defs/number"
        },
        "delivered_market_1_mwh": {
          "$ref": "#/$defs/number"
        },
        "delivered_market_2_mwh": {
          "$ref": "#/$defs/number"
        },
        "share_days_worth_trading": {
          "$ref": "#/$defs/nullable_number"
        },
        "selling_periods_per_day": {
          "type": "integer",
          "minimum": 1
        },
        "buying_periods_per_day": {
          "type": "integer",
          "minimum": 1
        }
      },
      "description": "The two markets as a pair; spread is market 2 less market 1. The periods-per-day counts calibrate the harvestable spread."
    },
    "profit_split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_arbitrage_gbp",
        "market_2_gap_gbp",
        "profit_gbp",
        "market_2_share"
      ],
      "properties": {
        "time_arbitrage_gbp": {
          "$ref": "#/$defs/number"
        },
        "market_2_gap_gbp": {
          "$ref": "#/$defs/number"
        },
        "profit_gbp": {
          "$ref": "#/$defs/number"
        },
        "market_2_share": {
          "$ref": "#/$defs/nullable_number"
        }
      },
      "description": "Profit valued at Market 1 prices, plus what using Market 2 added. Exact: the parts sum to the profit."
    },
    "cycles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "used",
        "budget",
        "prorated_budget",
        "prorated_crossed_at",
        "volume_lost_mwh",
        "realised_margin_gbp_per_mwh",
        "cycles_per_day",
        "forgone_per_year_gbp"
      ],
      "properties": {
        "used": {
          "$ref": "#/$defs/number"
        },
        "budget": {
          "$ref": "#/$defs/number"
        },
        "prorated_budget": {
          "$ref": "#/$defs/number"
        },
        "prorated_crossed_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/local_timestamp"
            }
          ]
        },
        "volume_lost_mwh": {
          "$ref": "#/$defs/number"
        },
        "realised_margin_gbp_per_mwh": {
          "$ref": "#/$defs/nullable_number"
        },
        "cycles_per_day": {
          "$ref": "#/$defs/nullable_number"
        },
        "forgone_per_year_gbp": {
          "$ref": "#/$defs/nullable_number"
        }
      },
      "description": "Cycles against the budget and against the cycle life pro-rated to the horizon, and what the wear cost at the plan's own margin."
    },
    "yardstick": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_gbp",
        "ratio",
        "days_below",
        "days",
        "volume_mwh"
      ],
      "properties": {
        "total_gbp": {
          "$ref": "#/$defs/number"
        },
        "ratio": {
          "$ref": "#/$defs/nullable_number"
        },
        "days_below": {
          "type": "integer",
          "minimum": 0
        },
        "days": {
          "type": "integer",
          "minimum": 0
        },
        "volume_mwh": {
          "$ref": "#/$defs/number"
        }
      },
      "description": "One ideal cycle of the nominal volume a day, bought at the day's floor and sold at its ceiling. Not a bound; an order-of-magnitude check."
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "years",
        "capex_gbp",
        "fixed_opex_gbp",
        "total_gbp",
        "shortfall_gbp"
      ],
      "properties": {
        "years": {
          "$ref": "#/$defs/number"
        },
        "capex_gbp": {
          "$ref": "#/$defs/number"
        },
        "fixed_opex_gbp": {
          "$ref": "#/$defs/number"
        },
        "total_gbp": {
          "$ref": "#/$defs/number"
        },
        "shortfall_gbp": {
          "$ref": "#/$defs/number"
        }
      },
      "description": "Capex and the horizon's fixed opex, which the dispatch does not depend on: context only."
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "both_charging_and_delivering",
        "market_2_not_flat_hours",
        "over_rate_limit",
        "over_degraded_volume",
        "over_cycle_budget"
      ],
      "properties": {
        "both_charging_and_delivering": {
          "type": "integer",
          "minimum": 0
        },
        "market_2_not_flat_hours": {
          "type": "integer",
          "minimum": 0
        },
        "over_rate_limit": {
          "type": "integer",
          "minimum": 0
        },
        "over_degraded_volume": {
          "type": "integer",
          "minimum": 0
        },
        "over_cycle_budget": {
          "type": "integer",
          "minimum": 0
        }
      },
      "description": "Violations of the model's constraints read off the plan: all zero for a sound plan."
    },
    "spread_explanation": {
      "description": "Daily profit regressed on each reading of the day's spread. 'realised' is an output of the dispatch, so it describes rather than explains.",
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "reading",
          "gbp_per_unit",
          "r2",
          "exogenous"
        ],
        "properties": {
          "key": {
            "enum": [
              "day_range",
              "harvestable_spread",
              "volatility",
              "market_gap",
              "realised",
              "price_level"
            ]
          },
          "reading": {
            "type": "string"
          },
          "gbp_per_unit": {
            "$ref": "#/$defs/nullable_number"
          },
          "r2": {
            "$ref": "#/$defs/nullable_number"
          },
          "exogenous": {
            "type": "boolean"
          }
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "daily",
        "monthly",
        "quarterly",
        "yearly",
        "profile",
        "spread_histogram",
        "net_power",
        "week"
      ],
      "properties": {
        "daily": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "profit_gbp",
            "cycles",
            "cycles_cumulative",
            "usable_volume_mwh",
            "mean_price",
            "buy_floor",
            "sell_ceiling",
            "day_range",
            "harvestable_spread",
            "delivered_mwh",
            "yardstick_gbp"
          ],
          "properties": {
            "date": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "date"
              }
            },
            "profit_gbp": {
              "$ref": "#/$defs/column"
            },
            "cycles": {
              "$ref": "#/$defs/column"
            },
            "cycles_cumulative": {
              "$ref": "#/$defs/column"
            },
            "usable_volume_mwh": {
              "$ref": "#/$defs/column"
            },
            "mean_price": {
              "$ref": "#/$defs/column"
            },
            "buy_floor": {
              "$ref": "#/$defs/column"
            },
            "sell_ceiling": {
              "$ref": "#/$defs/column"
            },
            "day_range": {
              "$ref": "#/$defs/column"
            },
            "harvestable_spread": {
              "$ref": "#/$defs/column"
            },
            "delivered_mwh": {
              "$ref": "#/$defs/column"
            },
            "yardstick_gbp": {
              "$ref": "#/$defs/column"
            }
          },
          "description": "One entry per day. cycles is spent that day, cycles_cumulative at its close; buy_floor and sell_ceiling are the day's cheapest and dearest price over both markets."
        },
        "monthly": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "month",
            "price_1_mean",
            "price_1_p10",
            "price_1_p90",
            "price_2_mean",
            "price_2_p10",
            "price_2_p90",
            "profit_gbp"
          ],
          "properties": {
            "month": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "date"
              }
            },
            "price_1_mean": {
              "$ref": "#/$defs/column"
            },
            "price_1_p10": {
              "$ref": "#/$defs/column"
            },
            "price_1_p90": {
              "$ref": "#/$defs/column"
            },
            "price_2_mean": {
              "$ref": "#/$defs/column"
            },
            "price_2_p10": {
              "$ref": "#/$defs/column"
            },
            "price_2_p90": {
              "$ref": "#/$defs/column"
            },
            "profit_gbp": {
              "$ref": "#/$defs/column"
            }
          },
          "description": "One entry per calendar month, keyed by its first day: mean price with the inter-decile band, and profit."
        },
        "quarterly": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quarter",
            "mean_price",
            "harvestable_spread"
          ],
          "properties": {
            "quarter": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "date"
              }
            },
            "mean_price": {
              "$ref": "#/$defs/column"
            },
            "harvestable_spread": {
              "$ref": "#/$defs/column"
            }
          },
          "description": "One entry per quarter, keyed by its first day."
        },
        "yearly": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "year",
            "profit_gbp",
            "mean_price_1",
            "mean_price_2",
            "cycles",
            "mean_day_range",
            "mean_harvestable",
            "profit_per_cycle",
            "yardstick_median_ratio",
            "share_days_beating_yardstick"
          ],
          "properties": {
            "year": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "profit_gbp": {
              "$ref": "#/$defs/column"
            },
            "mean_price_1": {
              "$ref": "#/$defs/column"
            },
            "mean_price_2": {
              "$ref": "#/$defs/column"
            },
            "cycles": {
              "$ref": "#/$defs/column"
            },
            "mean_day_range": {
              "$ref": "#/$defs/column"
            },
            "mean_harvestable": {
              "$ref": "#/$defs/column"
            },
            "profit_per_cycle": {
              "$ref": "#/$defs/column"
            },
            "yardstick_median_ratio": {
              "$ref": "#/$defs/column"
            },
            "share_days_beating_yardstick": {
              "$ref": "#/$defs/column"
            }
          },
          "description": "One entry per calendar year in the horizon, partial years included."
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hour",
            "price_1",
            "price_2",
            "charge_1_mw",
            "charge_2_mw",
            "discharge_1_mw",
            "discharge_2_mw",
            "share_charging",
            "share_delivering",
            "share_idle"
          ],
          "properties": {
            "hour": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/number"
              }
            },
            "price_1": {
              "$ref": "#/$defs/column"
            },
            "price_2": {
              "$ref": "#/$defs/column"
            },
            "charge_1_mw": {
              "$ref": "#/$defs/column"
            },
            "charge_2_mw": {
              "$ref": "#/$defs/column"
            },
            "discharge_1_mw": {
              "$ref": "#/$defs/column"
            },
            "discharge_2_mw": {
              "$ref": "#/$defs/column"
            },
            "share_charging": {
              "$ref": "#/$defs/column"
            },
            "share_delivering": {
              "$ref": "#/$defs/column"
            },
            "share_idle": {
              "$ref": "#/$defs/column"
            }
          },
          "description": "The mean day: one entry per half hour, hour = 0, 0.5, ... 23.5."
        },
        "spread_histogram": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "clip",
            "edges",
            "counts"
          ],
          "properties": {
            "clip": {
              "$ref": "#/$defs/number"
            },
            "edges": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/number"
              }
            },
            "counts": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "description": "Periods by price_2 - price_1, clipped to +/- clip; counts[i] lies between edges[i] and edges[i+1]."
        },
        "net_power": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "days",
            "hours",
            "values"
          ],
          "properties": {
            "days": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "date"
              }
            },
            "hours": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/number"
              }
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/column"
              }
            }
          },
          "description": "Net power, MW (+ delivering, - charging), to 0.1 MW: values[d][h] is day days[d] at hour hours[h]."
        },
        "week": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "timestamp",
            "price_1",
            "price_2",
            "charge_1_mw",
            "charge_2_mw",
            "discharge_1_mw",
            "discharge_2_mw",
            "storage_mwh"
          ],
          "properties": {
            "timestamp": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/local_timestamp"
              }
            },
            "price_1": {
              "$ref": "#/$defs/column"
            },
            "price_2": {
              "$ref": "#/$defs/column"
            },
            "charge_1_mw": {
              "$ref": "#/$defs/column"
            },
            "charge_2_mw": {
              "$ref": "#/$defs/column"
            },
            "discharge_1_mw": {
              "$ref": "#/$defs/column"
            },
            "discharge_2_mw": {
              "$ref": "#/$defs/column"
            },
            "storage_mwh": {
              "$ref": "#/$defs/column"
            }
          },
          "description": "Seven whole days at half-hourly resolution, the run of seven whose profit is the median of all such runs; the whole horizon when it is shorter. Charging and discharging are per market."
        }
      },
      "description": "The series the results page draws, column-oriented: each block holds one key array and arrays of the same length."
    }
  },
  "$defs": {
    "number": {
      "type": "number"
    },
    "nullable_number": {
      "type": [
        "number",
        "null"
      ]
    },
    "column": {
      "type": "array",
      "items": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "local_timestamp": {
      "description": "YYYY-MM-DDTHH:MM:SS on the price data's clock, no offset.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"
    }
  }
}
